generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Para login con Credentials
  plan          String    @default("STANDARD") // STANDARD, PRO
  stripeCustomerId String? @unique
  createdAt     DateTime  @default(now())
  cars          UserCar[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Brand {
  id     String     @id @default(cuid())
  name   String     @unique // e.g., Fiat, BMW
  models CarModel[]
}

model CarModel {
  id       String       @id @default(cuid())
  name     String       // e.g., Uno Way, Serie 7
  brandId  String
  brand    Brand        @relation(fields: [brandId], references: [id])
  catalogs CatalogCar[]

  @@unique([name, brandId])
}

model CatalogCar {
  id       String            @id @default(cuid())
  year     Int
  engine   String?           // e.g., 1.4L, 3.0L
  trim     String?           // e.g., M Sport
  modelId  String
  model    CarModel          @relation(fields: [modelId], references: [id])
  userCars UserCar[]

  @@unique([modelId, year])
}

model MaintenanceTask {
  id           String           @id @default(cuid())
  name         String           // e.g., Cambio de aceite, Afinación
  frequencyKm  Int?             // e.g., 10000
  frequencyMo  Int?             // e.g., 6 (months)
  userCarId    String
  userCar      UserCar          @relation(fields: [userCarId], references: [id], onDelete: Cascade)
  history      ServiceHistory[]
  maintenanceChecks MaintenanceCheck[]
}

model UserCar {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  catalogCarId String
  catalogCar   CatalogCar       @relation(fields: [catalogCarId], references: [id])
  
  color        String?
  licensePlate String?
  vin          String?
  currentKm    Int              @default(0)
  imageUrl     String?
  
  tasks        MaintenanceTask[]
  history      ServiceHistory[]
  reminders    Reminder[]
  maintenanceChecks MaintenanceCheck[]
  documents    CarDocument[]
  fuelLogs     FuelLog[]
}

model CarDocument {
  id           String   @id @default(cuid())
  userCarId    String
  userCar      UserCar  @relation(fields: [userCarId], references: [id], onDelete: Cascade)
  type         String   // Seguro, Tarjeta, Verificación, Factura, Otros
  name         String
  imageUrl     String?  @default("") // Base64
  expiryDate   DateTime?
  createdAt    DateTime @default(now())
}

model FuelLog {
  id           String   @id @default(cuid())
  userCarId    String
  userCar      UserCar  @relation(fields: [userCarId], references: [id], onDelete: Cascade)
  date         DateTime @default(now())
  km           Int
  liters       Float
  totalCost    Float
  createdAt    DateTime @default(now())
}

model ServiceHistory {
  id          String           @id @default(cuid())
  date        DateTime
  cost        Float?
  kmAtService Int
  userCarId   String
  userCar     UserCar          @relation(fields: [userCarId], references: [id], onDelete: Cascade)
  taskId      String?          // Opcional por si es un servicio genérico
  task        MaintenanceTask? @relation(fields: [taskId], references: [id])
  customName  String?          // Nombre para reparaciones o gastos libres
  notes       String?          // Detalles adicionales
  imageUrl    String?          // Foto del comprobante o trabajo
}

model Reminder {
  id        String   @id @default(cuid())
  title     String
  date      DateTime
  detail    String?
  userCarId String
  userCar   UserCar  @relation(fields: [userCarId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model MaintenanceCheck {
  id          String   @id @default(cuid())
  userCarId   String
  taskId      String
  kmMilestone Int
  createdAt   DateTime @default(now())

  userCar     UserCar         @relation(fields: [userCarId], references: [id], onDelete: Cascade)
  task        MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userCarId, taskId, kmMilestone])
}

model MaintenanceCatalog {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "nissan versa"
  tasksJson String   // Almacena el plan en formato JSON para flexibilidad
  updatedAt DateTime @updatedAt
}
